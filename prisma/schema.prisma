generator client {
  provider     = "prisma-client"
  output       = "../packages/db/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  VIEWER
}

enum LoginThrottleScope {
  IDENTIFIER
  SOURCE
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum AuditAction {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  USER_CREATED
  USER_EMAIL_CHANGED
  USER_PASSWORD_RESET
  USER_SESSIONS_REVOKED
  USER_DISABLED
  USER_ENABLED
  AUTHORIZATION_DENIED
}

enum ChannelAvailabilityStatus {
  ACTIVE
  DELETED_OR_TERMINATED
  NOT_FOUND
  TEMPORARILY_UNAVAILABLE
  CHECK_FAILED
  UNKNOWN
  ARCHIVED
}

enum ChannelActivityStatus {
  ACTIVE_RECENT
  DORMANT
  NO_UPLOAD_HISTORY
  UNKNOWN
}

enum ChannelSnapshotSource {
  YOUTUBE_PUBLIC_PAGE
  YTDLP
  YOUTUBE_RSS
  OPTIONAL_PROVIDER
  DERIVED
}

enum CoverageStatus {
  COMPLETE
  PARTIAL
}

enum SyncRunJobType {
  CHANNEL_RESOLVE
  CHANNEL_CURRENT_STATS
  CHANNEL_DAILY_FINALIZE
  CHANNEL_HEALTH
  RSS_DISCOVERY
  YTDLP_RECONCILE
  VIDEO_SNAPSHOT_HOT
  VIDEO_SNAPSHOT_WARM
  BREAKOUT_RECALC
  DAILY_AI_REPORT
  WEEKLY_AI_REPORT
  FULL_RECONCILE
}

enum SyncRunStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum VideoMonitorTier {
  HOT
  WARM
  OLD_HOT
  PINNED
  ARCHIVED
}

model WorkerHeartbeat {
  workerId   String   @id @map("worker_id") @db.VarChar(128)
  version    String   @db.VarChar(64)
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(3)
  status     String   @db.VarChar(32)

  @@index([lastSeenAt(sort: Desc)], map: "worker_heartbeats_last_seen_at_idx")
  @@map("worker_heartbeats")
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique(map: "users_email_key") @db.VarChar(320)
  passwordHash  String     @map("password_hash") @db.Text
  role          UserRole
  isEnabled     Boolean    @default(true) @map("is_enabled")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  disabledAt    DateTime?  @map("disabled_at") @db.Timestamptz(3)
  sessions      Session[]
  auditAsActor  AuditLog[] @relation("AuditActor")
  auditAsTarget AuditLog[] @relation("AuditTarget")

  @@index([role, isEnabled], map: "users_role_enabled_idx")
  @@map("users")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         Bytes     @unique(map: "sessions_token_hash_key") @map("token_hash") @db.ByteA
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revocationReason  String?   @map("revocation_reason") @db.VarChar(64)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt], map: "sessions_user_revoked_idx")
  @@index([idleExpiresAt], map: "sessions_idle_expiry_idx")
  @@index([absoluteExpiresAt], map: "sessions_absolute_expiry_idx")
  @@map("sessions")
}

model LoginThrottle {
  id              String             @id @default(uuid()) @db.Uuid
  scope           LoginThrottleScope
  keyHash         Bytes              @map("key_hash") @db.ByteA
  attemptCount    Int                @default(0) @map("attempt_count")
  windowStartedAt DateTime           @map("window_started_at") @db.Timestamptz(3)
  blockedUntil    DateTime?          @map("blocked_until") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([scope, keyHash], map: "login_throttles_scope_key_hash_key")
  @@index([blockedUntil], map: "login_throttles_blocked_until_idx")
  @@map("login_throttles")
}

model AuditLog {
  id           String       @id @default(uuid()) @db.Uuid
  actorUserId  String?      @map("actor_user_id") @db.Uuid
  targetUserId String?      @map("target_user_id") @db.Uuid
  action       AuditAction
  outcome      AuditOutcome
  requestId    String?      @map("request_id") @db.VarChar(128)
  metadata     Json?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target       User?        @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt(sort: Desc)], map: "audit_logs_actor_created_idx")
  @@index([targetUserId, createdAt(sort: Desc)], map: "audit_logs_target_created_idx")
  @@index([createdAt(sort: Desc)], map: "audit_logs_created_at_idx")
  @@map("audit_logs")
}

model Channel {
  id                       String                    @id @default(uuid()) @db.Uuid
  youtubeChannelId         String                    @unique(map: "channels_youtube_channel_id_key") @map("youtube_channel_id") @db.VarChar(24)
  originalInput            String                    @map("original_input") @db.Text
  canonicalUrl              String                    @map("canonical_url") @db.Text
  handle                   String?                   @db.VarChar(64)
  title                    String                    @db.VarChar(512)
  description              String?                   @db.Text
  thumbnail                String?                   @db.Text
  subscriberCount          BigInt?                   @map("subscriber_count")
  videoCount               BigInt?                   @map("video_count")
  lifetimeViewCount        BigInt?                   @map("lifetime_view_count")
  lastUploadAt             DateTime?                 @map("last_upload_at") @db.Timestamptz(3)
  availabilityStatus       ChannelAvailabilityStatus @default(ACTIVE) @map("availability_status")
  activityStatus           ChannelActivityStatus     @default(UNKNOWN) @map("activity_status")
  lastChannelScanAt        DateTime?                 @map("last_channel_scan_at") @db.Timestamptz(3)
  lastHealthCheckAt        DateTime?                 @map("last_health_check_at") @db.Timestamptz(3)
  lastSeenAliveAt          DateTime?                 @map("last_seen_alive_at") @db.Timestamptz(3)
  consecutiveHealthFailures Int                       @default(0) @map("consecutive_health_failures")
  firstUnavailableAt       DateTime?                 @map("first_unavailable_at") @db.Timestamptz(3)
  isEnabled                Boolean                   @default(true) @map("is_enabled")
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt               DateTime?                 @map("archived_at") @db.Timestamptz(3)
  snapshots                ChannelSnapshot[]
  healthChecks             ChannelHealthCheck[]
  videos                   Video[]
  videoSnapshots           VideoSnapshot[]
  dailyStats               ChannelDailyStat[]
  syncRuns                 SyncRun[]

  @@index([handle], map: "channels_handle_idx")
  @@index([availabilityStatus], map: "channels_availability_status_idx")
  @@index([activityStatus], map: "channels_activity_status_idx")
  @@map("channels")
}

model ChannelSnapshot {
  id                 String                @id @default(uuid()) @db.Uuid
  channelId          String                @map("channel_id") @db.Uuid
  capturedAt         DateTime              @map("captured_at") @db.Timestamptz(3)
  subscriberCount    BigInt?               @map("subscriber_count")
  videoCount         BigInt?               @map("video_count")
  lifetimeViewCount  BigInt?               @map("lifetime_view_count")
  lastUploadAt       DateTime?             @map("last_upload_at") @db.Timestamptz(3)
  source             ChannelSnapshotSource
  sourceDetails      Json?                 @map("source_details")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  channel            Channel               @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@index([channelId, capturedAt(sort: Desc)], map: "channel_snapshots_channel_captured_idx")
  @@map("channel_snapshots")
}

model ChannelHealthCheck {
  id                    String                    @id @default(uuid()) @db.Uuid
  channelId             String                    @map("channel_id") @db.Uuid
  checkedAt             DateTime                  @map("checked_at") @db.Timestamptz(3)
  publicPageStatus      String                    @map("public_page_status") @db.VarChar(64)
  ytdlpStatus           String                    @map("ytdlp_status") @db.VarChar(64)
  rssStatus             String                    @map("rss_status") @db.VarChar(64)
  normalizedAvailability ChannelAvailabilityStatus @map("normalized_availability")
  evidenceCode          String                    @map("evidence_code") @db.VarChar(64)
  evidenceTextSafe      String?                   @map("evidence_text_safe") @db.VarChar(256)
  httpStatus            Int?                      @map("http_status")
  durationMs            Int                       @map("duration_ms")
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  channel               Channel                   @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@index([channelId, checkedAt(sort: Desc)], map: "channel_health_checks_channel_checked_idx")
  @@index([normalizedAvailability, checkedAt(sort: Desc)], map: "channel_health_checks_availability_checked_idx")
  @@map("channel_health_checks")
}

model Video {
  id                String            @id @default(uuid()) @db.Uuid
  youtubeVideoId    String            @unique(map: "videos_youtube_video_id_key") @map("youtube_video_id") @db.VarChar(32)
  channelId         String            @map("channel_id") @db.Uuid
  title             String?           @db.Text
  description       String?           @db.Text
  thumbnail         String?           @db.Text
  publishedAt       DateTime?         @map("published_at") @db.Timestamptz(3)
  durationSeconds   Int?              @map("duration_seconds")
  currentViews      BigInt?           @map("current_views")
  currentLikes      BigInt?           @map("current_likes")
  currentComments   BigInt?           @map("current_comments")
  vph1h             Decimal?          @map("vph_1h") @db.Decimal(24, 6)
  vph3h             Decimal?          @map("vph_3h") @db.Decimal(24, 6)
  vph6h             Decimal?          @map("vph_6h") @db.Decimal(24, 6)
  breakout24h       Decimal?          @map("breakout_24h") @db.Decimal(24, 6)
  breakout48h       Decimal?          @map("breakout_48h") @db.Decimal(24, 6)
  breakout7d        Decimal?          @map("breakout_7d") @db.Decimal(24, 6)
  monitorTier       VideoMonitorTier  @default(WARM) @map("monitor_tier")
  firstSeenAt       DateTime          @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt        DateTime          @map("last_seen_at") @db.Timestamptz(3)
  isAvailable       Boolean           @default(true) @map("is_available")
  isPinned          Boolean           @default(false) @map("is_pinned")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  channel           Channel           @relation(fields: [channelId], references: [id], onDelete: Restrict)
  snapshots         VideoSnapshot[]

  @@index([channelId, publishedAt(sort: Desc)], map: "videos_channel_published_idx")
  @@index([monitorTier, lastSeenAt(sort: Desc)], map: "videos_tier_seen_idx")
  @@index([vph1h(sort: Desc)], map: "videos_vph_1h_idx")
  @@index([breakout48h(sort: Desc)], map: "videos_breakout_48h_idx")
  @@map("videos")
}

model VideoSnapshot {
  id             String                @id @default(uuid()) @db.Uuid
  videoId        String                @map("video_id") @db.Uuid
  channelId      String                @map("channel_id") @db.Uuid
  capturedAt     DateTime              @map("captured_at") @db.Timestamptz(3)
  snapshotBucket DateTime              @map("snapshot_bucket") @db.Timestamptz(3)
  views          BigInt?
  likes          BigInt?
  comments       BigInt?
  source         ChannelSnapshotSource
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  video          Video                 @relation(fields: [videoId], references: [id], onDelete: Restrict)
  channel        Channel               @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@unique([videoId, snapshotBucket], map: "video_snapshots_video_bucket_key")
  @@index([videoId, capturedAt(sort: Desc)], map: "video_snapshots_video_captured_idx")
  @@index([channelId, capturedAt(sort: Desc)], map: "video_snapshots_channel_captured_idx")
  @@map("video_snapshots")
}

model ChannelDailyStat {
  id                   String         @id @default(uuid()) @db.Uuid
  channelId            String         @map("channel_id") @db.Uuid
  date                 DateTime       @db.Date
  subscriberCount      BigInt?        @map("subscriber_count")
  videoCount           BigInt?        @map("video_count")
  lifetimeViewCount    BigInt?        @map("lifetime_view_count")
  subscriberDelta      BigInt?        @map("subscriber_delta")
  videoDelta           BigInt?        @map("video_delta")
  viewDelta            BigInt?        @map("view_delta")
  coverageStatus       CoverageStatus @map("coverage_status")
  sourceSummary        Json           @map("source_summary")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  channel              Channel        @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@unique([channelId, date], map: "channel_daily_stats_channel_date_key")
  @@index([channelId, date], map: "channel_daily_stats_channel_date_idx")
  @@map("channel_daily_stats")
}

model SyncRun {
  id                String         @id @default(uuid()) @db.Uuid
  channelId         String?        @map("channel_id") @db.Uuid
  jobType           SyncRunJobType  @map("job_type")
  status            SyncRunStatus
  startedAt         DateTime?      @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?      @map("completed_at") @db.Timestamptz(3)
  recordsProcessed  Int?           @map("records_processed")
  errorCode         String?        @map("error_code") @db.VarChar(64)
  errorMessageSafe  String?        @map("error_message_safe") @db.VarChar(512)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  channel           Channel?       @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@index([channelId, createdAt(sort: Desc)], map: "sync_runs_channel_created_idx")
  @@index([jobType, status, createdAt(sort: Desc)], map: "sync_runs_job_status_created_idx")
  @@map("sync_runs")
}
