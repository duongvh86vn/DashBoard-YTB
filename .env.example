NODE_ENV=production
DEPLOYMENT_MODE=PUBLIC
APP_VERSION=0.1.0
APP_PUBLIC_URL=https://yt.example.com

WEB_PORT=3000
API_PORT=5000
LAN_PROXY_PORT=8080
API_INTERNAL_URL=http://api:5000

POSTGRES_USER=youtube_monitor
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=youtube_monitor
DATABASE_URL=postgresql://youtube_monitor:replace-with-a-url-encoded-password@postgres:5432/youtube_monitor

SESSION_SECRET=
SECRET_ENCRYPTION_KEY=

SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=24
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

APP_TIMEZONE=Asia/Bangkok
TRUST_PROXY=true

CHANNEL_ACTIVE_UPLOAD_DAYS=30

RSS_SCAN_MINUTES=15
CHANNEL_SCAN_HOURS=6
CHANNEL_HEALTH_HOURS=6

VIDEO_HOT_SCAN_MINUTES=60
VIDEO_WARM_SCAN_HOURS=3
VIDEO_OLD_HOT_SCAN_HOURS=6

VIDEO_RECENT_DAYS=30
VIDEO_CANDIDATE_RETENTION_DAYS=45

HEALTH_FIRST_RETRY_MINUTES=30
HEALTH_DELETE_CONFIRMATIONS=2

PLAYWRIGHT_CONCURRENCY=1
YTDLP_CONCURRENCY=2

WORKER_ID=
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_STALE_SECONDS=45

GEMINI_API_KEY=
GEMINI_FAST_MODEL=
GEMINI_ANALYSIS_MODEL=

NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_FAST_MODEL=
NVIDIA_ANALYSIS_MODEL=
NVIDIA_LONG_CONTEXT_MODEL=

AI_DAILY_REPORT_ENABLED=true
AI_WEEKLY_REPORT_ENABLED=true
